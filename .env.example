# Application
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://metering:metering@localhost:5432/metering

# Stripe (Test Mode Only - No Credit Card Required)
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price ID for Pro Plan (create in Stripe Dashboard > Products)
# This is the monthly price for the Pro plan
STRIPE_PRO_PRICE_ID=price_your_pro_price_id_here

# App URL (for Stripe Checkout success/cancel redirects)
APP_URL=http://localhost:3000